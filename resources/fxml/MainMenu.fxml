<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>

<AnchorPane prefHeight="500.0"
            prefWidth="700.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="client.presentation.MainMenuViewController">

    <children>

        <Label layoutX="210.0"
               layoutY="30.0"
               style="-fx-font-size: 24px;"
               text="Distributed Temperature Monitor" />

        <Label layoutX="40.0"
               layoutY="100.0"
               text="Sensor ID:" />

        <TextField fx:id="sensorIdField"
                   layoutX="120.0"
                   layoutY="95.0"
                   prefWidth="180.0" />

        <Button fx:id="connectButton"
                layoutX="330.0"
                layoutY="95.0"
                text="Connect"
                onAction="#connectToServer"  />

        <Button fx:id="disconnectButton"
                layoutX="430.0"
                layoutY="95.0"
                text="Disconnect"
                disable="true"
                onAction="#disconnectFromServer"/>

        <Label layoutX="40.0"
               layoutY="160.0"
               style="-fx-font-size: 18px;"
               text="Temperature Log" />

        <ListView fx:id="temperatureList"
                  layoutX="40.0"
                  layoutY="190.0"
                  prefHeight="200.0"
                  prefWidth="300.0" />

        <Label layoutX="420.0"
               layoutY="190.0"
               text="Average Temperature:" />

        <Label fx:id="averageLabel"
               layoutX="580.0"
               layoutY="190.0"
               text="0.0" />

        <Label layoutX="420.0"
               layoutY="230.0"
               text="Highest Temperature:" />

        <Label fx:id="highestLabel"
               layoutX="580.0"
               layoutY="230.0"
               text="0.0" />

        <Label layoutX="420.0"
               layoutY="270.0"
               text="Measurements:" />

        <Label fx:id="measurementLabel"
               layoutX="580.0"
               layoutY="270.0"
               text="0" />

        <Label fx:id="warningLabel"
               layoutX="40.0"
               layoutY="420.0"
               style="-fx-text-fill: red; -fx-font-size: 16px;"
               text="" />

    </children>

</AnchorPane>